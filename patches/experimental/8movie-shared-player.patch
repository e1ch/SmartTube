+package com.liskovsoft.smartyoutubetv2.common.app.models.external;
+
+import com.liskovsoft.sharedutils.rx.RxHelper;
+import com.liskovsoft.smartyoutubetv2.common.app.models.data.Video;
+import com.liskovsoft.smartyoutubetv2.common.app.models.data.VideoGroup;
+
+import java.util.Arrays;
+import java.util.List;
+
+import io.reactivex.Observable;
+
+public final class ExternalVideoProviderRegistry {
+    private static final boolean ENABLE_EXPERIMENTAL_PROVIDERS = true;
+    private static final List<ExternalVideoProvider> PROVIDERS = Arrays.asList(
+            new EightMovieProvider()
+    );
+
+    private ExternalVideoProviderRegistry() {
+    }
+
+    public static Observable<VideoGroup> getHomeGroupObserve() {
+        return RxHelper.fromCallable(() -> {
+            if (!ENABLE_EXPERIMENTAL_PROVIDERS) {
+                return VideoGroup.from(new java.util.ArrayList<>());
+            }
+
+            for (ExternalVideoProvider provider : PROVIDERS) {
+                VideoGroup group = provider.getHomeGroup();
+                if (group != null && !group.isEmpty()) {
+                    return group;
+                }
+            }
+
+            return VideoGroup.from(new java.util.ArrayList<>());
+        });
+    }
+
+    public static ExternalVideo resolve(Video video) {
+        ExternalVideoProvider provider = find(video);
+        return provider != null ? provider.resolve(video) : null;
+    }
+
+    public static Observable<ExternalVideo> resolveObserve(Video video) {
+        return RxHelper.fromCallable(() -> resolve(video));
+    }
+
+    public static Video next(Video video) {
+        ExternalVideoProvider provider = find(video);
+        return provider != null ? provider.next(video) : null;
+    }
+
+    private static ExternalVideoProvider find(Video video) {
+        if (video == null || video.externalSourceId == null) {
+            return null;
+        }
+
+        for (ExternalVideoProvider provider : PROVIDERS) {
+            if (video.externalSourceId.equals(provider.getId())) {
+                return provider;
+            }
+        }
+
+        return null;
+    }
+}
