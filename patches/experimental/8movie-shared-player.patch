@@ -0,0 +1,237 @@
+package com.liskovsoft.smartyoutubetv2.common.app.models.external;
+
+import android.text.Html;
+import android.text.TextUtils;
+
+import com.liskovsoft.smartyoutubetv2.common.app.models.data.Video;
+import com.liskovsoft.smartyoutubetv2.common.app.models.data.VideoGroup;
+
+import java.io.BufferedReader;
+import java.io.IOException;
+import java.io.InputStreamReader;
+import java.net.HttpURLConnection;
+import java.net.URL;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+public class EightMovieProvider implements ExternalVideoProvider {
+    private static final String ID = "8movie";
+    private static final String BASE_URL = "https://8movie.com";
+    private static final String USER_AGENT = "Mozilla/5.0 (Android TV; Linux; SmartTube Ash) AppleWebKit/537.36 Chrome/125 Safari/537.36";
+    private static final Pattern MOVIE_LINK = Pattern.compile("<a[^>]+href=[\"'](?:https?://8movie\\.com)?/movies/(\\d+)/?[\"'][^>]*>(.*?)</a>", Pattern.CASE_INSENSITIVE | Pattern.DOTALL);
+    private static final Pattern DIRECT_MEDIA = Pattern.compile("(?:(https?:)?//)[^\"'<>\\\\]+\\.(?:mp4|m3u8)(?:\\?[^\"'<>\\\\]*)?", Pattern.CASE_INSENSITIVE);
+    private static final Pattern META_COUNT = Pattern.compile("<meta[^>]+name=[\"']count[\"'][^>]+content=[\"'](\\d+)[\"']", Pattern.CASE_INSENSITIVE);
+    private static final Pattern UU_VAR = Pattern.compile("var\\s+uu\\s*=\\s*[\"']([^\"']+)[\"']", Pattern.CASE_INSENSITIVE);
+    private static final Pattern VIDEO_LITERAL = Pattern.compile("video\\s*:\\s*[\"']([^\"']+)[\"']", Pattern.CASE_INSENSITIVE);
+
+    @Override
+    public String getId() {
+        return ID;
+    }
+
+    @Override
+    public VideoGroup getHomeGroup() {
+        String html = fetch(BASE_URL + "/", headers(BASE_URL + "/"));
+        Matcher matcher = MOVIE_LINK.matcher(html);
+        List<Video> videos = new ArrayList<>();
+        Set<String> seen = new HashSet<>();
+
+        while (matcher.find() && videos.size() < 12) {
+            String contentId = matcher.group(1);
+            if (!seen.add(contentId)) {
+                continue;
+            }
+
+            String title = cleanTitle(matcher.group(2));
+            if (TextUtils.isEmpty(title)) {
+                continue;
+            }
+
+            videos.add(Video.fromExternal(
+                    ID,
+                    contentId,
+                    "1",
+                    0,
+                    title,
+                    "8movie • 第001集",
+                    null,
+                    playUrl(contentId, "1"),
+                    null,
+                    headers(BASE_URL + "/movies/" + contentId + "/")));
+        }
+
+        VideoGroup group = VideoGroup.from(videos);
+        group.setTitle("8movie 實驗來源");
+        return group;
+    }
+
+    @Override
+    public ExternalVideo resolve(Video video) {
+        if (video == null) {
+            return null;
+        }
+
+        Map<String, String> headers = video.externalHeaders != null ? video.externalHeaders : headers(video.externalPageUrl);
+        String directUrl = video.externalPlaybackUrl;
+
+        if (TextUtils.isEmpty(directUrl)) {
+            String pageUrl = !TextUtils.isEmpty(video.externalPageUrl) ? video.externalPageUrl : playUrl(video.externalContentId, video.externalEpisodeId);
+            String html = fetch(pageUrl, headers(pageUrl));
+            video.externalEpisodeCount = extractEpisodeCount(html, video.externalEpisodeCount);
+            directUrl = extractMediaUrl(html);
+            headers = headers(pageUrl);
+        }
+
+        if (TextUtils.isEmpty(directUrl)) {
+            throw new IllegalStateException("8movie playback URL not found. Provider page may require a cookie or changed its player script.");
+        }
+
+        return new ExternalVideo(normalizeUrl(directUrl), headers);
+    }
+
+    @Override
+    public Video next(Video current) {
+        if (current == null || current.externalEpisodeCount <= 0) {
+            return null;
+        }
+
+        int episode = parseEpisode(current.externalEpisodeId);
+        int nextEpisode = episode + 1;
+        if (nextEpisode > current.externalEpisodeCount) {
+            return null;
+        }
+
+        String episodeId = String.valueOf(nextEpisode);
+        return Video.fromExternal(
+                ID,
+                current.externalContentId,
+                episodeId,
+                current.externalEpisodeCount,
+                current.title,
+                String.format("8movie • 第%03d集", nextEpisode),
+                current.cardImageUrl,
+                playUrl(current.externalContentId, episodeId),
+                null,
+                headers(current.externalPageUrl));
+    }
+
+    private static String fetch(String url, Map<String, String> headers) {
+        HttpURLConnection connection = null;
+        try {
+            connection = (HttpURLConnection) new URL(url).openConnection();
+            connection.setConnectTimeout(15_000);
+            connection.setReadTimeout(15_000);
+            connection.setInstanceFollowRedirects(true);
+            for (Map.Entry<String, String> header : headers.entrySet()) {
+                connection.setRequestProperty(header.getKey(), header.getValue());
+            }
+
+            int code = connection.getResponseCode();
+            if (code == 403 || code == 503) {
+                throw new IllegalStateException("8movie cookie required or provider blocked request. Status: " + code);
+            }
+
+            BufferedReader reader = new BufferedReader(new InputStreamReader(connection.getInputStream()));
+            StringBuilder builder = new StringBuilder();
+            String line;
+            while ((line = reader.readLine()) != null) {
+                builder.append(line).append('\n');
+            }
+            String html = builder.toString();
+            if (html.contains("Attention Required") && html.contains("Cloudflare")) {
+                throw new IllegalStateException("8movie cookie required or Cloudflare blocked request.");
+            }
+            return html;
+        } catch (IOException e) {
+            throw new IllegalStateException("8movie request failed: " + url, e);
+        } finally {
+            if (connection != null) {
+                connection.disconnect();
+            }
+        }
+    }
+
+    private static Map<String, String> headers(String referer) {
+        Map<String, String> headers = new HashMap<>();
+        headers.put("User-Agent", USER_AGENT);
+        headers.put("Accept", "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8");
+        headers.put("Accept-Language", "zh-TW,zh;q=0.9,en;q=0.7");
+        if (!TextUtils.isEmpty(referer)) {
+            headers.put("Referer", referer);
+        }
+        return headers;
+    }
+
+    private static String playUrl(String contentId, String episodeId) {
+        return BASE_URL + "/play/" + contentId + "/" + parseEpisode(episodeId) + "/";
+    }
+
+    private static int parseEpisode(String episodeId) {
+        try {
+            return Integer.parseInt(episodeId);
+        } catch (NumberFormatException e) {
+            return 1;
+        }
+    }
+
+    private static int extractEpisodeCount(String html, int fallback) {
+        Matcher matcher = META_COUNT.matcher(html);
+        if (matcher.find()) {
+            try {
+                return Integer.parseInt(matcher.group(1));
+            } catch (NumberFormatException ignored) {
+                return fallback;
+            }
+        }
+        return fallback;
+    }
+
+    private static String extractMediaUrl(String html) {
+        Matcher direct = DIRECT_MEDIA.matcher(html);
+        if (direct.find()) {
+            return direct.group();
+        }
+
+        Matcher uu = UU_VAR.matcher(html);
+        if (uu.find()) {
+            return uu.group(1);
+        }
+
+        Matcher literal = VIDEO_LITERAL.matcher(html);
+        if (literal.find()) {
+            return literal.group(1);
+        }
+
+        return null;
+    }
+
+    private static String normalizeUrl(String url) {
+        if (url == null) {
+            return null;
+        }
+
+        if (url.startsWith("//")) {
+            return "https:" + url;
+        }
+
+        if (!url.startsWith("http://") && !url.startsWith("https://")) {
+            return "https://" + url;
+        }
+
+        return url;
+    }
+
+    private static String cleanTitle(String html) {
+        String noTags = html.replaceAll("<[^>]+>", " ").replaceAll("\\s+", " ").trim();
+        if (android.os.Build.VERSION.SDK_INT >= android.os.Build.VERSION_CODES.N) {
+            return Html.fromHtml(noTags, Html.FROM_HTML_MODE_LEGACY).toString().trim();
+        }
+        return Html.fromHtml(noTags).toString().trim();
+    }
+}
